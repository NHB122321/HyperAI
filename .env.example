
OPENAI_API_KEY=replace_with_your_openai_api_key
TELEGRAM_BOT_TOKEN=replace_with_your_telegram_bot_token
TELEGRAM_ALLOWED_USER_ID=123456789

# Маршрутизация обычных текстовых запросов и распознанного голоса.
FAST_MODEL=gpt-5.6-luna
SMART_MODEL=gpt-6-astra
MODEL_MODE=auto

# Распознавание голоса использует свою модель, независимо от /fast и /smart.
TRANSCRIPTION_MODEL=gpt-transcribe

